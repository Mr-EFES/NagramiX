"NagramiX.Ghost.Privacy" = "தனிமறைவு";
"NagramiX.Ghost.Functions" = "அம்சங்கள்";
"NagramiX.Ghost.MasterInfo" = "திறக்கப்பட்டால், தேர்ந்தெடுக்கப்பட்ட பண்புகள் NagramiX கணக்குகளுக்கு பொருந்தும். இயங்குதளத்தை அணைப்பது உங்கள் தனிப்பட்ட விருப்பங்களைத் தக்க வைத்துக் கொள்கிறது.";
"NagramiX.Ghost.messageReads" = "செய்தி படிப்பு ரசீதுகளை மறைக்கவும்";
"NagramiX.Ghost.messageReads.Info" = "அனுப்புநரிடம் சொல்லாமல் உள்ளூர் உரையாடல்கள் படிக்கப்படுகின்றன. ஒலி மறுபடியும் ஒலிப்பதிவு மற்றும் ஒருமுறை பயன்படுத்தப்படும் இணைப்புகளை பார்ப்பது ஆகியவை அறிக்கையிடப்படவில்லை. ஏற்கனவே அனுப்பிய ரசீதுகளை திரும்பப் பெற முடியாது.";
"NagramiX.Ghost.storyReads" = "கதை காட்சிகளை மறைத்தல்";
"NagramiX.Ghost.storyReads.Info" = "புதிய கதை காட்சி ரசீதுகளை அனுப்ப வேண்டாம். பதில்கள் மற்றும் எதிர்வினைகள் இன்னும் காணப்படுகின்றன. உங்கள் தனிப்பட்ட கதை மறைமுக விருப்பம் பாதுகாக்கப்படுகிறது.";
"NagramiX.Ghost.online" = "இணையத்தில் நிலையை மறைத்தல்";
"NagramiX.Ghost.online.Info" = "NagramiX நீங்கள் பயன்பாட்டைப் பயன்படுத்தும் போது உங்கள் இணைய நிலையை புதுப்பிக்காது. ஏற்கனவே காணக்கூடிய ஒரு நிலையை உடனடியாக மாற்ற தானியங்கி ஆஃப்லைனை இயக்கவும்.";
"NagramiX.Ghost.typing" = "தட்டச்சு மற்றும் பதிவுகளை மறைத்தல்";
"NagramiX.Ghost.typing.Info" = "தட்டச்சு, குரல் பதிவு, வீடியோ பதிவு மற்றும் பிற அரட்டை செயல்பாடு குறிகாட்டிகளை மறைக்கவும். குரல் அழைப்புகள் இயல்பாக செயல்படுகின்றன.";
"NagramiX.Ghost.automaticOffline" = "தானியங்கி ஆஃப்லைன்";
"NagramiX.Ghost.automaticOffline.Info" = "பேய் பயன்முறையை இயக்கும் போது மற்றும் பயன்பாடு திறக்கும் போதெல்லாம் உடனடியாக ஆஃப்லைனில் இருந்து வெளியேறுங்கள். மறைக்கவும் இணையத்தில் நிலையை மறைக்கவும் திறக்கவும்.";
"NagramiX.Ghost.readOnAction" = "அனுப்புதல் அல்லது எதிர்வினை செய்யும் போது வாசிக்கவும்";
"NagramiX.Ghost.readOnAction.Info" = "ஒரு செய்தியை அனுப்புவது வழக்கமான உரையாடலை வாசித்ததாகக் குறிக்கிறது. ஒரு எதிர்வினை, எதிர்வினை செய்தியை நோக்கி செய்திகளை குறிக்கிறது. இந்த செயல்களுக்கான ரசீதுகளை மறைக்க இதை அணைத்து விடுங்கள்.";
"NagramiX.Ghost.Search" = "பேய் கண்ணுக்கு தெரியாத மறைமுக தனியுரிமை வாசிக்க ரசீதுகள் கதைகள் இணையதளத்தில் ஆஃப்லைன் தட்டச்சு பதிவு குரல் எதிர்வினை பதில்";
"NagramiX.Ghost.Limits" = "Telegram இன் மற்ற வாடிக்கையாளர்களில் செயல்பாடு உங்கள் நிலையை மாற்றக்கூடும். நீங்கள் அனுப்புவது செய்திகள், பதில்கள் மற்றும் எதிர்வினைகள் தொடர்ந்து தெரியும். அழைப்புகள் மற்றும் மறைந்துபோன செய்திகளை ஒழுங்குபடுத்தும் நேரம் இயல்பான முறையை பராமரிக்கிறது. தனியுரிமை உள்ள சேவையகங்களில் உள்ள உள்ளூர் வாசிப்பு மற்றும் வாசிப்பு முறைகள் செய்தி பெறுதல்களுக்கு மட்டுமே முன்னுரிமையைக் கொண்டுள்ளன.";
