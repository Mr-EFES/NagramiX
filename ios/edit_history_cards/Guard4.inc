import Foundation
import TelegramPresentationData

public enum NagramiXAppLocalization {
    private static let bundle: Bundle? = {
        let containing = Bundle(for: NagramiXLocalizationMarker.self)
        guard let path = containing.path(forResource: "NagramiXLocalization", ofType: "bundle") else { return nil }
        return Bundle(path: path)
    }()

    public static func languageCandidates(_ languageCode: String) -> [String] {
        let code = languageCode.replacingOccurrences(of: "_", with: "-").lowercased()
        let aliases = ["zh-cn": "zh-hans", "zh-sg": "zh-hans", "zh-tw": "zh-hant", "zh-hk": "zh-hant", "zh-mo": "zh-hant", "zh": "zh-hans", "pt": "pt-br", "no": "nb", "tl": "fil", "iw": "he", "in": "id"]
        var result: [String] = []
        var value = code
        while !value.isEmpty {
            for candidate in [value, aliases[value]].compactMap({ $0 }) where !result.contains(candidate) { result.append(candidate) }
            guard let separator = value.lastIndex(of: "-") else { break }
            value = String(value[..<separator])
        }
        return result
    }

    public static func localized(_ key: String, languageCode: String, fallbackLanguageCode: String? = nil) -> String {
        guard let bundle = self.bundle else { return key }
        var candidates = self.languageCandidates(languageCode)
        if let secondary = fallbackLanguageCode { candidates += self.languageCandidates(secondary) }
        candidates.append("en")
        for candidate in candidates {
            guard let path = bundle.path(forResource: candidate, ofType: "lproj"), let language = Bundle(path: path) else { continue }
            let value = language.localizedString(forKey: key, value: "__NAGRAMIX_MISSING__", table: nil)
            if value != "__NAGRAMIX_MISSING__" { return value }
        }
        return key
    }

    static func format(_ template: String, arguments: [String]) -> String {
        guard let expression = try? NSRegularExpression(pattern: "%([1-9][0-9]*)\\$@|%%") else { return template }
        let output = NSMutableString(string: template)
        let matches = expression.matches(in: template, range: NSRange(location: 0, length: (template as NSString).length))
        for match in matches.reversed() {
            let token = (template as NSString).substring(with: match.range)
            if token == "%%" { output.replaceCharacters(in: match.range, with: "%"); continue }
            guard let index = Int((template as NSString).substring(with: match.range(at: 1))), index > 0, index <= arguments.count else { continue }
            output.replaceCharacters(in: match.range, with: arguments[index - 1])
        }
        return output as String
    }
}

